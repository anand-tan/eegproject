    "import mne\n",
    "import numpy as np\n",
    "\n",
    "# Patient 1 (chb17) EDF list from your summary\n",
    "train_files = [\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_01.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_02.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_03.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_04.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_05.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_06.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_07.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_08.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_09.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_10.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_11.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_12.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_13.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_14.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_15.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_16.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_17.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_18.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_19.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_20.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_21.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_22.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_23.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_24.edf\"},\n",
    "    {\"path\": \"chb-mit-scalp-eeg-database-1.0.0/chb17/chb17_25.edf\"}\n",
    "]\n",
    "\n",
    "all_features = []\n",
    "lengths = []\n",
    "\n",
    "for i, f_info in enumerate(train_files, start=1):\n",
    "    path = f_info[\"path\"]\n",
    "\n",
    "    raw = mne.io.read_raw_edf(path, preload=True, verbose=False)\n",
    "    raw.rename_channels(lambda x: x.strip(\".\"))\n",
    "\n",
    "    # Safety: ensure we really have 256 Hz (resample if not)\n",
    "    if raw.info[\"sfreq\"] != 256:\n",
    "        raw.resample(256, npad=\"auto\", verbose=False)\n",
    "\n",
    "    raw.filter(1.0, 40.0, fir_design=\"firwin\", verbose=False)\n",
    "    raw.notch_filter(freqs=[60], verbose=False)\n",
    "\n",
    "    # 5s fixed-length epochs\n",
    "    epochs = mne.make_fixed_length_epochs(raw, duration=5.0, preload=True, verbose=False)\n",
    "    data = epochs.get_data()  # shape: (n_epochs, n_channels, n_times)\n",
    "\n",
    "    feats = get_advanced_state_features(data, sfreq=int(raw.info[\"sfreq\"]))\n",
    "    all_features.append(feats)\n",
    "    lengths.append(len(feats))\n",
    "\n",
    "    if i % 5 == 0 or i == len(train_files):\n",
    "        print(f\"Loaded {i}/{len(train_files)} files; last epochs={len(feats)}\")\n",
    "\n",
    "print(\"Loading complete.\")\n"
